import pathlib as pl
import sys

import matplotlib.dates as mdates
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from pytrnsys_process import api

# The runner runs this script with the system's directory as working directory, so `common`
# isn't on the module search path.
sys.path.insert(0, str(pl.Path(__file__).resolve().parents[1] / "common"))

import process.lcoh as common_lcoh  # noqa: E402


def filter(sim: api.Simulation):
    sim.monthly.index = pd.to_datetime(sim.monthly.index)

    last_year = sim.monthly.index.year[-1]

    sim.monthly = sim.monthly[sim.monthly.index.year == last_year]

    sim.hourly.index = pd.to_datetime(sim.hourly.index)
    sim.hourly = sim.hourly[sim.hourly.index.year == last_year]


def weather(sim: api.Simulation):
    #### Calculations ####
    sim.hourly["IT_H_kW"] = sim.hourly["IT_H"] / 3600
    sim.monthly["IT_H_kW"] = sim.monthly["IT_H"] / 3600

    #### Plots ####
    fig, ax = api.line_plot(sim.hourly, ["Tamb"])
    ax.set_ylabel("Temperature [°C]")
    plt.grid()
    ax.legend_.remove()
    api.export_plots_in_configured_formats(fig, sim.path, "temp-hourly", "weather")

    fig, ax = api.line_plot(sim.hourly, ["IT_H_kW"])
    ax.set_ylabel("Radiation [kW/m2]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "hor-rad-hourly", "weather")

    fig, ax = api.bar_chart(sim.monthly, ["IT_H_kW"])
    ax.set_ylabel("Radiation [kWh/m2]")
    ax.legend_.remove()
    api.export_plots_in_configured_formats(fig, sim.path, "hor-rad-monthly", "weather")

    # Monthly radiation (bars, right axis) + hourly ambient temperature (line, left axis)
    month_start = sim.monthly.index.to_period("M").to_timestamp()
    fig, ax = plt.subplots()
    ax.bar(
        month_start,
        sim.monthly["IT_H_kW"],
        width=month_start.days_in_month * 0.9,
        align="edge",
        color="tab:orange",
        alpha=0.6,
    )
    ax.set_ylabel("Radiation [kWh/m2]")
    ax2 = ax.twinx()
    ax.yaxis.set_label_position("right")
    ax.yaxis.tick_right()
    ax2.plot(sim.hourly.index, sim.hourly["Tamb"], color="tab:blue", linewidth=0.5)
    ax2.set_ylabel("Temperature [°C]")
    ax2.yaxis.set_label_position("left")
    ax2.yaxis.tick_left()
    ax2.grid()
    ax2.xaxis.set_major_locator(mdates.MonthLocator())
    ax2.xaxis.set_major_formatter(mdates.DateFormatter("%b"))
    handles = ax2.get_lines() + list(ax.containers[0])[:1]
    ax2.legend(
        handles, ["Ambient temperature", "Total horizontal radiation"], loc="upper left"
    )
    api.export_plots_in_configured_formats(
        fig, sim.path, "temp-hor-rad-monthly", "weather"
    )


def solar(sim: api.Simulation):
    #### Calculations ####
    sim.monthly["CollP_MW"] = sim.monthly["CollP_kW"] / 1000

    sim.scalar["CollP_kW_calc_Tot"] = sim.hourly["CollP_kW_calc"].sum()
    sim.scalar["CollIT_kW_Tot"] = sim.hourly["CollIT_kW"].sum()

    sim.scalar["Q_kW_m2"] = sim.scalar["CollP_kW_calc_Tot"] / sim.scalar["CollAcollAp"]
    sim.scalar["IT_kW_m2"] = sim.scalar["CollIT_kW_Tot"] / sim.scalar["CollAcollAp"]
    sim.scalar["qSysOut_PipeLoss_Tot"] = sim.hourly["qSysOut_PipeLoss"].sum()

    # Stagnation
    sim.hourly["SolarControlStagDays"] = (
        sim.hourly["SolarControlStagDays"] - sim.hourly["SolarControlStagDays"].iloc[1]
    )
    sim.scalar["SolarControlStagDays"] = sim.hourly["SolarControlStagDays"].iloc[-1]

    #### Plots ####
    fig, ax = api.line_plot(sim.hourly / 1e3, ["CollP_kW"], use_legend=False)
    ax.set_ylabel("Power [MW]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "solar-hourly", "solar")

    fig, ax = api.bar_chart(sim.monthly / 1e3, ["CollP_kW"], use_legend=False)
    ax.set_ylabel("Energy [MWh]")
    ax.legend()
    ax.legend_ = None
    api.export_plots_in_configured_formats(fig, sim.path, "solar-monthly", "solar")

    fig, ax = api.line_plot(sim.hourly, ["CollTIn", "CollTOut"])
    ax.set_ylabel("Temperature [°C]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "temp-hourly", "solar")

    fig, ax = api.line_plot(sim.hourly, ["SolarControlStag"])
    ax.set_ylabel("Stagnation ON [-]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "stagnation-hourly", "solar")

    df = pd.DataFrame(
        {"T": sim.hourly["CollTOut"], "Q": sim.hourly["CollP_kW_calc"] / 1e6}
    )

    df = df.sort_values(by="T")
    df["Q_cum"] = np.cumsum(df["Q"])

    plt.figure()
    fig = plt.plot(df["T"], df["Q_cum"])
    plt.xlabel("$T_{coll,out}$ [°C]")
    plt.ylabel("$Q_{coll,cum}$ [GWh]")
    plt.tight_layout()
    plt.grid()
    api.export_plots_in_configured_formats(fig[0].figure, sim.path, "q_t", "solar")


def ttes(sim: api.Simulation):
    #### Calculations ####
    sim.scalar["QLoss_Tes1_Tot"] = sim.hourly["QLoss_Tes1"].sum()

    sim.scalar["Qdp1_Tes1_Tot"] = sim.hourly["Qdp1_Tes1"].sum()
    sim.scalar["Qdp2_Tes1_Tot"] = sim.hourly["Qdp2_Tes1"].sum()
    sim.scalar["QAcum_Tes1_Tot"] = sim.hourly["QAcum_Tes1"].sum()

    sim.scalar["Qdp1_Tes1_Pos_Tot"] = sim.hourly["Qdp1_Tes1_Pos"].sum()
    sim.scalar["Qdp1_Tes1_Neg_Tot"] = sim.hourly["Qdp1_Tes1_Neg"].sum()

    sim.scalar["TesQCharge_Tot"] = (
        sim.scalar["Qdp1_Tes1_Pos_Tot"] + sim.scalar["Qdp2_Tes1_Tot"]
    )
    sim.scalar["TesQDisharge_Tot"] = sim.scalar["Qdp1_Tes1_Neg_Tot"]

    sim.scalar["TesQMax"] = (
        sim.scalar["Vol_Tes1"]
        * sim.scalar["RhoWat_Tes1"]
        * sim.scalar["CpWat_Tes1"]
        * (sim.scalar["TTesMax"] - 0)
        / 3600
    )
    # Nominal capacity: from max storage temperature down to district heating return temperature
    sim.scalar["TesTRetDH"] = sim.scalar["TSetDem"] - sim.scalar["QSnkdT"]
    sim.scalar["TesCap_kWh"] = (
        sim.scalar["Vol_Tes1"]
        * sim.scalar["RhoWat_Tes1"]
        * sim.scalar["CpWat_Tes1"]
        * (sim.scalar["TTesMax"] - sim.scalar["TesTRetDH"])
        / 3600
    )

    sim.scalar["TesCap_MWh"] = sim.scalar["TesCap_kWh"] / 1000

    # Number of cycles (Solites criterion): discharged energy / capacity over the simulated
    # temperature swing, i.e. max minus min of all storage node temperatures in the last year
    tes_nodes = [f"T{i}_Tes1" for i in range(1, 11)]
    sim.scalar["TesTMaxSim"] = sim.hourly[tes_nodes].max().max()
    sim.scalar["TesTMinSim"] = sim.hourly[tes_nodes].min().min()
    sim.scalar["TesCapSim_kWh"] = (
        sim.scalar["Vol_Tes1"]
        * sim.scalar["RhoWat_Tes1"]
        * sim.scalar["CpWat_Tes1"]
        * (sim.scalar["TesTMaxSim"] - sim.scalar["TesTMinSim"])
        / 3600
    )
    sim.scalar["TesNCycles"] = (
        sim.scalar["TesQDisharge_Tot"] / sim.scalar["TesCapSim_kWh"]
    )

    sim.scalar["TesEff"] = abs(
        sim.scalar["TesQDisharge_Tot"] / sim.scalar["TesQCharge_Tot"]
    )

    sim.hourly["TesSoc"] = (sim.hourly["TAvg_Tes1"] - 0) / (95 - 0)

    ## Energy density calculation
    cp = sim.scalar["CpWat_Tes1"]
    rho = sim.scalar["RhoWat_Tes1"]
    sim.scalar["rhoQ"] = (
        (max(sim.hourly["TAvg_Tes1"]) - min(sim.hourly["TAvg_Tes1"])) * rho * cp / 3600
    )

    #### Plots ####
    fig, ax = api.line_plot(
        sim.hourly,
        [
            "T1_Tes1",
            "T2_Tes1",
            "T3_Tes1",
            "T4_Tes1",
            "T5_Tes1",
            "T6_Tes1",
            "T7_Tes1",
            "T8_Tes1",
            "T9_Tes1",
            "T10_Tes1",
        ],
    )
    ax.set_ylabel("Temperature [°C]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "t-ptes-hourly", "ttes")

    fig, ax = api.line_plot(sim.hourly, ["QLoss_Tes1"], use_legend=False)
    ax.set_ylabel("Power [kW]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "top-losses-hourly", "ttes")

    fig, ax = api.line_plot(sim.hourly, ["TesSoc"])
    ax.set_ylabel("SOC [-]")
    ax.legend_.remove()
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "soc-hourly", "ttes")

    #### Monthly balance ####
    fig, ax = api.energy_balance(
        sim.monthly,
        q_in_columns=[
            "Qdp1_Tes1_Pos",
            "Qdp2_Tes1",
        ],
        q_out_columns=[
            "Qdp1_Tes1_Neg",
            "QLoss_Tes1",
            "QAcum_Tes1",
        ],
        xlabel="",
    )
    ax.legend(
        [
            "Charge at top",
            "Charge at middle",
            "Discharge",
            "Losses",
            "Stored",
            "Imbalance",
        ],
        loc="upper center",
    )
    api.export_plots_in_configured_formats(fig, sim.path, "balance-monthly", "ttes")

    #### Q vs T ####
    names_legend = [
        "$Q_{charging,top}(T_{in})$",
        "$Q_{discharging}(T_{in})$",
        "$Q_{charging,middle}(T_{in})$",
        "$Q_{charging,top}(T_{out})$",
        "$Q_{discharging}(T_{out})$",
        "$Q_{charging,middle}(T_{out})$",
    ]
    plot_variables = [
        ["Qdp1_Tes1_Pos", "Tdp1In_Tes1"],
        ["Qdp1_Tes1_Neg", "Tdp1InRev_Tes1"],
        ["Qdp2_Tes1", "Tdp2In_Tes1"],
        ["Qdp1_Tes1_Pos", "TTesDpL99_4"],
        ["Qdp1_Tes1_Neg", "TTesDpL99_4"],
        ["Qdp2_Tes1", "TTesDpL50_1"],
    ]

    plt.figure()

    for q, t in plot_variables:
        a = abs(sim.hourly[q])
        b = sim.hourly[t]
        df = pd.DataFrame({q: a, t: b})

        df = df.sort_values(by=t)
        df[q] = np.cumsum(df[q])

        fig = plt.plot(df[t], df[q], label=q + "____" + t)

    plt.xlabel("Temperature [°C]")
    plt.ylabel("Cumulative energy [kWh]")
    plt.grid()
    plt.legend(names_legend)
    api.export_plots_in_configured_formats(fig[0].figure, sim.path, "q_t", "ttes")


def boiler(sim: api.Simulation):
    #### Calculations ####
    sim.scalar["BolrPOut_kW_Tot"] = sim.hourly["BolrPOut_kW"].sum()

    #### Plots ####
    fig, ax = api.line_plot(sim.hourly / 1e3, ["BolrPOut_kW"], use_legend=False)
    ax.set_ylabel("Power [MW]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "boiler-hourly", "boiler")


def source(sim: api.Simulation):
    #### Calculations ####
    sim.scalar["QSrcP_kW_Tot"] = sim.hourly["QSrcP_kW"].sum()

    #### Plots ####
    fig, ax = api.line_plot(sim.hourly, ["QSrcP_kW"], use_legend=False)
    ax.set_ylabel("Power [kW]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "source-hourly", "source")


def demand(sim: api.Simulation):
    #### Calculations ####
    sim.scalar["QSnkP_kW_Tot"] = sim.hourly["QSnkP_kW"].sum()
    sim.scalar["QSnkTIn_Avg"] = sim.hourly["QSnkTIn"].mean()
    sim.scalar["QSnkTOut_Avg"] = sim.hourly["QSnkTOut"].mean()
    sim.step["QSnkPreal_kW"] = 0
    # Losses
    sim.scalar["qSysOut_dpToFFieldTot_Tot"] = sim.hourly["qSysOut_dpToFFieldTot"].sum()
    sim.scalar["qSysOut_dpPipeIntTot_Tot"] = sim.hourly["qSysOut_dpPipeIntTot"].sum()
    sim.scalar["qSysOut_dpSoilIntTot_Tot"] = sim.hourly["qSysOut_dpSoilIntTot"].sum()

    sim.monthly["QDistrict"] = (
        sim.monthly["qSysOut_dpToFFieldTot"]
        + sim.monthly["qSysOut_dpPipeIntTot"]
        + sim.monthly["qSysOut_dpSoilIntTot"]
    )

    sim.monthly["QDemand_kW"] = sim.monthly["QSnkP_kW"] + sim.monthly["QDistrict"]
    sim.scalar["QDemand_kW_Tot"] = sim.monthly["QDemand_kW"].sum()

    #### Plots ####
    fig, ax = api.line_plot(sim.hourly / 1e3, ["QSnkP_kW"], use_legend=False)
    ax.set_ylabel("Power [MW]")
    plt.grid()
    api.export_plots_in_configured_formats(fig, sim.path, "sink-hourly", "sink")


def balance(sim: api.Simulation):
    #### Calculations ####
    sim.scalar["QSources"] = (
        sim.scalar["CollP_kW_calc_Tot"]
        + sim.scalar["BolrPOut_kW_Tot"]
        + sim.scalar["QSrcP_kW_Tot"]
    )
    sim.scalar["QSinks"] = sim.scalar["QSnkP_kW_Tot"]
    sim.scalar["QStore"] = sim.scalar["QAcum_Tes1_Tot"]
    sim.scalar["QLosses"] = (
        sim.scalar["QLoss_Tes1_Tot"]
        + sim.scalar["qSysOut_PipeLoss_Tot"]
        + sim.scalar["qSysOut_dpPipeIntTot_Tot"]
    )

    sim.scalar["QImb"] = (
        sim.scalar["QSources"]
        - sim.scalar["QStore"]
        - sim.scalar["QSinks"]
        - sim.scalar["QLosses"]
    )

    #### Plots ####
    # Unit changes
    sim.monthly["CollP_kW_calc_MW"] = sim.monthly["CollP_kW_calc"] / 1000
    sim.monthly["BolrPOut_MW"] = sim.monthly["BolrPOut_kW"] / 1000
    sim.monthly["QSrcP_MW"] = sim.monthly["QSrcP_kW"] / 1000

    sim.monthly["QSnkP_MW"] = sim.monthly["QSnkP_kW"] / 1000
    sim.monthly["QAcum_Tes1_MW"] = sim.monthly["QAcum_Tes1"] / 1000
    sim.monthly["QLoss_Tes1_MW"] = sim.monthly["QLoss_Tes1"] / 1000
    sim.monthly["qSysOut_PipeLoss_MW"] = sim.monthly["qSysOut_PipeLoss"] / 1000
    sim.monthly["QDistrict_MW"] = sim.monthly["QDistrict"] / 1000

    # Yearly values
    sim.scalar["CollP_kW_calc_MW"] = sim.monthly["CollP_kW_calc_MW"].sum()
    sim.scalar["BolrPOut_MW"] = sim.monthly["BolrPOut_MW"].sum()
    sim.scalar["QSrcP_MW"] = sim.monthly["QSrcP_MW"].sum()

    sim.scalar["QSnkP_MW"] = sim.monthly["QSnkP_MW"].sum()
    sim.scalar["QAcum_Tes1_MW"] = sim.monthly["QAcum_Tes1_MW"].sum()
    sim.scalar["QLoss_Tes1_MW"] = sim.monthly["QLoss_Tes1_MW"].sum()
    sim.scalar["qSysOut_PipeLoss_MW"] = sim.monthly["qSysOut_PipeLoss_MW"].sum()
    sim.scalar["QDistrict_MW"] = sim.monthly["QDistrict_MW"].sum()

    names_legend = [
        "$Q_{Coll}$",
        "$Q_{Boiler}$",
        "$Q_{Demand}$",
        "$Q_{TTES,Accum}$",
        "$Q_{TTES,Losses}$",
        "$Q_{Imb}$",
    ]

    # Monthly Resultes
    fig, ax = api.energy_balance(
        sim.monthly / 1e3,
        q_in_columns=["CollP_kW_calc_MW", "BolrPOut_MW", "QSrcP_MW"],
        q_out_columns=[
            "QSnkP_MW",
            "QAcum_Tes1_MW",
            "QLoss_Tes1_MW",
        ],
        xlabel="",
        cmap="Paired",
    )
    ax.set_ylabel("Energy [GWh]")
    plt.legend(names_legend, bbox_to_anchor=(1.05, 1), loc="upper left")
    api.export_plots_in_configured_formats(fig, sim.path, "balance-monthly", "balance")

    # Yearly
    fig, ax = api.energy_balance(
        sim.scalar,
        q_in_columns=["CollP_kW_calc_MW", "BolrPOut_MW", "QSrcP_MW"],
        q_out_columns=[
            "QSnkP_MW",
            "QAcum_Tes1_MW",
            "QLoss_Tes1_MW",
            "qSysOut_PipeLoss_MW",
            "QDistrict_MW",
        ],
        xlabel="",
        cmap="Paired",
    )
    ax.set_ylabel("Energy [MWh]")
    plt.legend(names_legend, bbox_to_anchor=(1.05, 1), loc="upper left")

    api.export_plots_in_configured_formats(fig, sim.path, "balance-yearly", "balance")


def q_vs_t(sim: api.Simulation):
    #### Q vs T ####
    names_legend = [
        "$Q_{coll}(T_{in})$",
        "$Q_{coll}(T_{out})$",
        "$Q_{dem}(T_{in})$",
        "$Q_{dem}(T_{out})$",
    ]
    plot_variables = [
        ["CollP_kW_calc", "CollTIn"],
        ["CollP_kW_calc", "CollTOut"],
        ["QSnkP_kW", "QSnkTIn"],
        ["QSnkP_kW", "QSnkTOut"],
    ]

    plt.figure()

    for q, t in plot_variables:
        a = abs(sim.hourly[q]) / 1e6
        b = sim.hourly[t]
        df = pd.DataFrame({q: a, t: b})

        df = df.sort_values(by=t)
        df[q] = np.cumsum(df[q])

        fig = plt.plot(df[t], df[q])

    plt.xlabel("Temperature [°C]")
    plt.ylabel("Cumulative energy [GWh]")
    plt.grid()
    plt.legend(names_legend)
    api.export_plots_in_configured_formats(fig[0].figure, sim.path, "q_t", "q_vs_t")


def kpi(sim: api.Simulation):
    ### Calculations ###
    sim.scalar["FactorRenewable"] = (
        sim.scalar["QSnkP_kW_Tot"] - sim.scalar["BolrPOut_kW_Tot"]
    ) / sim.scalar["QSnkP_kW_Tot"]

    data = [
        sim.scalar["IT_kW_m2"],
        sim.scalar["CollP_kW_calc_Tot"] / 1000,
        sim.scalar["Q_kW_m2"],
        sim.scalar["TesQCharge_Tot"] / 1000,
        sim.scalar["TesQDisharge_Tot"] / 1000,
        sim.scalar["QLoss_Tes1_Tot"] / 1000,
        sim.scalar["QDistrict_MW"],
        sim.scalar["QAcum_Tes1_Tot"] / 1000,
        sim.scalar["BolrPOut_kW_Tot"] / 1000,
        sim.scalar["QDemand_kW_Tot"] / 1000,
        sim.scalar["SolarControlStagDays"],
        sim.scalar["TesEff"],
        sim.scalar["TesNCycles"],
        sim.scalar["QSnkTIn_Avg"],
        sim.scalar["QSnkTOut_Avg"],
    ]
    df = pd.DataFrame(data)

    df.to_csv(sim.path + "\\data.csv", header=False, index=False)
    sim.hourly.to_csv(sim.path + "\\hourly.csv", header=True, index=True)


def lcoh(sim: api.Simulation):
    common_lcoh.add_lcoh(
        sim,
        storage_volume_water_equivalent_m3=float(sim.scalar["Vol_Tes1"].iloc[0]),
        has_heat_pump=False,
    )


def to_json(sim: api.Simulation):
    sim.scalar.to_json(sim.path + r"\output.json", orient="records", indent=4)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print(f"ERROR: Usage: {sys.argv[0]} <path-to-results-folder>", file=sys.stderr)
        sys.exit(-1)

    path_to_results_folder = pl.Path(sys.argv[1])
    api.global_settings.reader.force_reread_prt = False
    api.global_settings.reader.read_step_files = True

    processing_steps = [
        filter,
        weather,
        solar,
        ttes,
        boiler,
        source,
        demand,
        balance,
        q_vs_t,
        kpi,
        lcoh,
        to_json,
    ]

    api.process_whole_result_set(
        path_to_results_folder,
        processing_steps,
    )
