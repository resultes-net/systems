def ttes(sim: api.Simulation):
    #### Read solites values ####
    df_solites = pd.read_csv('solites_temp.csv', sep=r',', header=None)
    sim.hourly["TtesTop_solites"] = df_solites.iloc[: len(sim.hourly), 1].values
    sim.hourly["Ttes2_solites"] = df_solites.iloc[: len(sim.hourly), 2].values
    sim.hourly["TtesMiddle_solites"] = df_solites.iloc[: len(sim.hourly), 3].values
    sim.hourly["Ttes4_solites"] = df_solites.iloc[: len(sim.hourly), 4].values
    sim.hourly["TtesBottom_solites"] = df_solites.iloc[: len(sim.hourly), 5].values


    #### Calculations ####
    sim.scalar["QLoss_Tes1_Tot"] = sim.hourly["QLoss_Tes1"].sum()
    # sim.scalar["QLoss_Tes1To_kW_Tot"] = sim.hourly["QLoss_Tes1To_kW"].sum()
    # sim.scalar["QLoss_Tes1Ed_kW_Tot"] = sim.hourly["QLoss_Tes1Ed_kW"].sum()
    # sim.scalar["QLoss_Tes1Bo_kW_Tot"] = sim.hourly["QLoss_Tes1Bo_kW"].sum()
    sim.scalar["Qdp1_Tes1_Tot"] = sim.hourly["Qdp1_Tes1"].sum()
    sim.scalar["Qdp2_Tes1_Tot"] = sim.hourly["Qdp2_Tes1"].sum()
    # sim.scalar["pitStoreQ31_kW_Tot"] = sim.hourly["pitStoreQ31_kW"].sum()
    sim.scalar["QAcum_Tes1_Tot"] = sim.hourly["QAcum_Tes1"].sum()


    sim.scalar["Qdp1_Tes1_Pos_Tot"] = sim.hourly["Qdp1_Tes1_Pos"].sum()
    sim.scalar["Qdp1_Tes1_Neg_Tot"] = sim.hourly["Qdp1_Tes1_Neg"].sum()



    sim.scalar["TesQCharge_Tot"] = sim.scalar["Qdp1_Tes1_Pos_Tot"] + sim.scalar["Qdp2_Tes1_Tot"]
    sim.scalar["TesQDisharge_Tot"] = sim.scalar["Qdp1_Tes1_Neg_Tot"]

    sim.scalar["TesQMax"] = (
        sim.scalar["Vol_Tes1"]
        * sim.scalar["RhoWat_Tes1"]
        * sim.scalar["CpWat_Tes1"]
        * (sim.scalar["SolarControlTTesMax"] - 0)
        / 3600
    )
    # Nominal capacity: from max storage temperature down to district heating return temperature
    sim.scalar["TesTRetDH"] = sim.scalar["TSetDem"] - sim.scalar["QSnkdT"]
    sim.scalar["TesCap_kWh"] = (
        sim.scalar["Vol_Tes1"]
        * sim.scalar["RhoWat_Tes1"]
        * sim.scalar["CpWat_Tes1"]
        * (sim.scalar["SolarControlTTesMax"] - sim.scalar["TesTRetDH"])
        / 3600
    )

    sim.scalar["TesCap_MWh"] = sim.scalar["TesCap_kWh"]/1000

    # Number of cycles (Solites criterion): discharged energy / capacity over the simulated
    # temperature swing, i.e. max minus min of all storage node temperatures in the last year
    tes_nodes = [f"T{i}_Tes1" for i in range(1, 11)]
    sim.scalar["TesTMaxSim"] = sim.hourly[tes_nodes].max().max()
    sim.scalar["TesTMinSim"] = sim.hourly[tes_nodes].min().min()
    sim.scalar["TesCapSim_kWh"] = (
        sim.scalar["Vol_Tes1"]
        * sim.scalar["RhoWat_Tes1"]
        * sim.scalar["CpWat_Tes1"]
        * (sim.scalar["TesTMaxSim"] - sim.scalar["TesTMinSim"])
        / 3600
    )
    sim.scalar["TesNCycles"] = (
        sim.scalar["TesQDisharge_Tot"] / sim.scalar["TesCapSim_kWh"]
    )

    sim.scalar["TesEff"] = abs(
        sim.scalar["TesQDisharge_Tot"] / sim.scalar["TesQCharge_Tot"]
    )

    sim.hourly["TesSoc"] = (sim.hourly["TAvg_Tes1"] - 0) / (95 - 0)

    ## Energy density calculation
    cp = sim.scalar["CpWat_Tes1"]
    rho = sim.scalar["RhoWat_Tes1"]
    sim.scalar["rhoQ"] = (
        (max(sim.hourly["TAvg_Tes1"]) - min(sim.hourly["TAvg_Tes1"]))
        * rho
        * cp
        / 3600
    )

    #### Plots ####
    names_legend = [
        '$T_{bottom,Resultes}$',
        '$T_{medium,Resultes}$',
        '$T_{top,Resultes}$',
        '$T_{bottom,Solites}$',
        '$T_{medium,Solites}$',
        '$T_{top,Solites}$',
    ]
    fig, ax = api.line_plot(
        sim.hourly, ["T2_Tes1","T4_Tes1","T9_Tes1",
                     # "T1_Tes1", "T2_Tes1", "T3_Tes1", "T4_Tes1", "T5_Tes1", "T6_Tes1", "T7_Tes1", "T8_Tes1", "T9_Tes1","T10_Tes1",
                     "Ttes4_solites", "TtesMiddle_solites", "Ttes2_solites"
    ]
    )

    lines = ax.get_lines()

    if len(lines) == 6:
        # Define colors for Top, Medium, Bottom
        color_top = '#D32F2F'  # Red
        color_medium = '#1976D2'  # Blue
        color_bottom = '#388E3C'  # Green

        # Set styles for the first group (Solid lines)
        lines[0].set_color(color_top)
        lines[0].set_linestyle('-')  # Solid line

        lines[1].set_color(color_medium)
        lines[1].set_linestyle('-')

        lines[2].set_color(color_bottom)
        lines[2].set_linestyle('-')

        # Set styles for the second group (Dashed lines, matching colors)
        lines[3].set_color(color_top)
        lines[3].set_linestyle('--')  # Dashed line

        lines[4].set_color(color_medium)
        lines[4].set_linestyle('--')

        lines[5].set_color(color_bottom)
        lines[5].set_linestyle('--')

    ax.set_ylabel("Temperature (°C)")
    plt.legend(names_legend)
    plt.grid()
    # plt.show()
    api.export_plots_in_configured_formats(fig, sim.path, "t-ptes-hourly", "ttes")

    fig, ax = api.line_plot(
        sim.hourly, ["QLoss_Tes1"]
    )
    ax.set_ylabel("Power (kW)")
    plt.grid()
    # plt.ylim(0, 10)
    # plt.show()
    api.export_plots_in_configured_formats(fig, sim.path, "top-losses-hourly", "ttes")

    # tes_temp_sensors_to_plot = get_tes_temp_sensors_to_plot(sim.hourly)
    #
    # fig, ax = api.line_plot(
    #     sim.hourly,
    #     list(tes_temp_sensors_to_plot),
    # )

    # ax.set_ylabel("Temperature (°C)")
    # plt.grid()
    # # plt.show()
    # api.export_plots_in_configured_formats(fig, sim.path, "t-nodes-ptes-hourly", "ptes")

    fig, ax = api.line_plot(sim.hourly, ["TesSoc"])
    ax.set_ylabel("SOC (-)")
    ax.legend_.remove()
    plt.grid()
    # plt.show()
    api.export_plots_in_configured_formats(fig, sim.path, "soc-hourly", "ttes")

    #### Monthly balance ####
    fig, ax = api.energy_balance(
        sim.monthly,
        q_in_columns=[
            "Qdp1_Tes1_Pos",
            "Qdp2_Tes1",
        ],
        q_out_columns=[
            "Qdp1_Tes1_Neg",
            "QLoss_Tes1",
            "QAcum_Tes1",
        ],
        xlabel="",
    )
    api.export_plots_in_configured_formats(fig, sim.path, "balance-monthly", "ttes")

    #### Q vs T ####
    names_legend = [
        "$Q_{charging,top}(T_{in})$",
        "$Q_{discharging}(T_{in})$",
        "$Q_{charging,middle}(T_{in})$",
        "$Q_{charging,top}(T_{out})$",
        "$Q_{discharging}(T_{out})$",
        "$Q_{charging,middle}(T_{out})$",
    ]
    plot_variables = [
        ["Qdp1_Tes1_Pos", "Tdp1In_Tes1"],
        ["Qdp1_Tes1_Neg", "Tdp1InRev_Tes1"],
        ["Qdp2_Tes1", "Tdp2In_Tes1"],
        ["Qdp1_Tes1_Pos", "TTesDpL99_4"],
        ["Qdp1_Tes1_Neg", "TTesDpL99_4"],
        ["Qdp2_Tes1", "TTesDpL50_1"],
    ]

    dataframes = pd.DataFrame()  # []

    plt.figure()

    for q, t in plot_variables:
        a = abs(sim.hourly[q])
        b = sim.hourly[t]
        df = pd.DataFrame({q: a, t: b})

        df = df.sort_values(by=t)
        df[q] = np.cumsum(df[q])
        # dataframes = dataframes + a + b
        # dataframes.append(df)

        fig = plt.plot(
            df[t], df[q], label=q + "____" + t
        )  # , linestyle='-', color='blue', label='Q_cum')

    plt.xlabel("Temperature [°C]")
    plt.ylabel("Cumulative energy [kWh]")
    plt.grid()
    plt.legend(names_legend)
    api.export_plots_in_configured_formats(fig[0].figure, sim.path, "q_t", "ttes")


def get_tes_temp_sensors_to_plot(hourly_dataframe: pd.DataFrame) -> cabc.Sequence[str]:
    n_plots = 10
    temp_sensors = [
        s for i in range(100) if (s := f"pitStoreTTankN{i}") in hourly_dataframe.columns
    ]
    n_temp_sensors = len(temp_sensors)

    if n_temp_sensors <= n_plots:
        return temp_sensors
    
    step = round(n_temp_sensors / n_plots)

    temp_sensors_to_plot = temp_sensors[:step:]

    return temp_sensors_to_plot


def hp(sim: api.Simulation):

    #### Calculations ####
    sim.scalar["HpQEvap_kW_Tot"] = sim.hourly["HpQEvap_kW"].sum()
    sim.scalar["HpQCond_kW_Tot"] = sim.hourly["HpQCond_kW"].sum()
    sim.scalar["HpPelComp_kW_Tot"] = sim.hourly["HpPelComp_kW"].sum()
    sim.scalar["HpCOP"] = sim.scalar["HpQCond_kW_Tot"] / sim.scalar["HpPelComp_kW_Tot"]
    # sim.step["HpControlFracCond_100"] = sim.step["HpControlFracCond"] * 100

    fig, ax = api.energy_balance(
        sim.monthly,
        q_in_columns=["HpPelComp_kW", "HpQEvap_kW"],
        q_out_columns=["HpQCond_kW"],
        xlabel="",
    )
    api.export_plots_in_configured_formats(fig, sim.path, "balance-monthly", "hp")

    #### Plots ####
    fig, ax = api.line_plot(sim.hourly, ["HpQCond_kW"])
    ax.set_ylabel("Power (kW)")
    plt.grid()
    # plt.show()
    api.export_plots_in_configured_formats(fig, sim.path, "qcond-hourly", "hp")

    #### Q vs T ####
    plot_variables = [
        ["HpQEvap_kW", "HpTEvapOut"],
        ["HpQCond_kW", "HpTCondOut"],
    ]

    dataframes = []

    plt.figure()

    for q, t in plot_variables:
        a = sim.hourly[q]
        b = sim.hourly[t]
        df = pd.DataFrame({q: a, t: b})

        df = df.sort_values(by=t)
        df[q] = np.cumsum(df[q])
        dataframes.append(df)

        fig = plt.plot(
            df[t], df[q], label=q + "____" + t
        )  # , linestyle='-', color='blue', label='Q_cum')

    plt.xlabel("Temperature [°C]")
    plt.ylabel("Cumulative energy [kWh]")
    plt.grid()
    plt.legend()
    # plt.show()
    api.export_plots_in_configured_formats(fig[0].figure, sim.path, "q_t", "hp")


