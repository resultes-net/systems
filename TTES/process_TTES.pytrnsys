def demand(sim: api.Simulation):

    #### Calculations ####
    sim.scalar["QSnkP_kW_Tot"] = sim.hourly["QSnkP_kW"].sum()
    sim.scalar["QSnkTIn_Avg"] = sim.hourly["QSnkTIn"].mean()
    sim.scalar["QSnkTOut_Avg"] = sim.hourly["QSnkTOut"].mean()
    sim.step["QSnkPreal_kW"] = 0
    # Losses
    sim.scalar["qSysOut_dpToFFieldTot_Tot"] = sim.hourly["qSysOut_dpToFFieldTot"].sum()
    sim.scalar["qSysOut_dpPipeIntTot_Tot"] = sim.hourly["qSysOut_dpPipeIntTot"].sum()
    sim.scalar["qSysOut_dpSoilIntTot_Tot"] = sim.hourly["qSysOut_dpSoilIntTot"].sum()

    sim.monthly["QDistrict"] = (
        sim.monthly["qSysOut_dpToFFieldTot"]
        + sim.monthly["qSysOut_dpPipeIntTot"]
        + sim.monthly["qSysOut_dpSoilIntTot"]
    )

    sim.monthly["QDemand_kW"] = sim.monthly["QSnkP_kW"] + sim.monthly["QDistrict"]
    sim.scalar["QDemand_kW_Tot"] = sim.monthly["QDemand_kW"].sum()

    #### Plots ####
    fig, ax = api.line_plot(sim.hourly, ["QSnkP_kW"])
    ax.set_ylabel("Power (kW)")
    ax.legend_.remove()
    plt.grid()
    # plt.show()
    api.export_plots_in_configured_formats(fig, sim.path, "sink-hourly", "sink")



def balance(sim: api.Simulation):
    #### Read solites values ####
    df_solites = pd.read_csv('solites_balance.csv', sep=r'\s+', header=None)
    df_solites = df_solites.T

    sim.monthly['solites_solar']    = df_solites[0].values
    sim.monthly['solites_losses']   = df_solites[4].values
    sim.monthly['solites_accum']    = df_solites[5].values
    sim.monthly['solites_aux']      = df_solites[6].values
    sim.monthly['solites_demand']   = df_solites[7].values




    #### Calculations ####
    sim.scalar["QSources"] = (
        sim.scalar["CollP_kW_calc_Tot"]
        + sim.scalar["BolrPOut_kW_Tot"]
        + sim.scalar["QSrcP_kW_Tot"]
    )
    sim.scalar["QSinks"] = sim.scalar["QSnkP_kW_Tot"]
    sim.scalar["QStore"] = sim.scalar["QAcum_Tes1_Tot"]
    sim.scalar["QLosses"] = (
        sim.scalar["QLoss_Tes1_Tot"]
        + sim.scalar["qSysOut_PipeLoss_Tot"]
        + sim.scalar["qSysOut_dpPipeIntTot_Tot"]
    )

    sim.scalar["QImb"] = (
        sim.scalar["QSources"]
        - sim.scalar["QStore"]
        - sim.scalar["QSinks"]
        - sim.scalar["QLosses"]
    )

    #### Plots ####
    # Unit changes
    sim.monthly["CollP_kW_calc_MW"] = sim.monthly["CollP_kW_calc"] / 1000
    # sim.monthly["HpPelComp_MW"] = sim.monthly["HpPelComp_kW"] / 1000
    sim.monthly["BolrPOut_MW"] = sim.monthly["BolrPOut_kW"] / 1000
    sim.monthly["QSrcP_MW"] = sim.monthly["QSrcP_kW"] / 1000

    sim.monthly["QSnkP_MW"] = sim.monthly["QSnkP_kW"] / 1000
    sim.monthly["QAcum_Tes1_MW"] = sim.monthly["QAcum_Tes1"] / 1000
    sim.monthly["QLoss_Tes1_MW"] = sim.monthly["QLoss_Tes1"] / 1000
    sim.monthly["qSysOut_PipeLoss_MW"] = sim.monthly["qSysOut_PipeLoss"] / 1000
    sim.monthly["QDistrict_MW"] = sim.monthly["QDistrict"] / 1000

    # Yearly values
    sim.scalar["CollP_kW_calc_MW"] = sim.monthly["CollP_kW_calc_MW"].sum()
    # sim.scalar["HpPelComp_MW"] = sim.monthly["HpPelComp_MW"].sum()
    sim.scalar["BolrPOut_MW"] = sim.monthly["BolrPOut_MW"].sum()
    sim.scalar["QSrcP_MW"] = sim.monthly["QSrcP_MW"].sum()

    sim.scalar["QSnkP_MW"] = sim.monthly["QSnkP_MW"].sum()
    sim.scalar["QAcum_Tes1_MW"] = sim.monthly["QAcum_Tes1_MW"].sum()
    sim.scalar["QLoss_Tes1_MW"] = sim.monthly["QLoss_Tes1_MW"].sum()
    sim.scalar["qSysOut_PipeLoss_MW"] = sim.monthly["qSysOut_PipeLoss_MW"].sum()
    sim.scalar["QDistrict_MW"] = sim.monthly["QDistrict_MW"].sum()

    # names_legend = [
    #     "$Q_{Coll}$",
    #     "$Q_{Boiler}$",
    #     "$Q_{Source}$",
    #     "$Q_{Demand}$",
    #     "$Q_{TTES,Accum}$",
    #     "$Q_{TTES,Losses}$",
    #     "$Q_{Pipes}$",
    #     "$Q_{District}$",
    #     "$Q_{Imb}$",
    # ]

    names_legend = [
        "$Q_{Coll}$",
        "$Q_{Boiler}$",
        "$Q_{Demand}$",
        "$Q_{TTES,Accum}$",
        "$Q_{TTES,Losses}$",
        "$Q_{Imb}$",
    ]

    custom_colors = [
        "#FF9F40",  # 1. Naranja (Ej. Colector solar)
        "#FF6384",  # 2. Rojo/Rosa (Ej. Caldera)
        "#36A2EB",  # 3. Azul (Ej. Demanda)
        "#4BC0C0",  # 4. Turquesa (Ej. Acumulación)
        "#9966FF",  # 5. Morado (Ej. Pérdidas)
        "#C9CBCF",  # 6. Gris claro (Ej. Desbalance)
        "#4CAF50",  # 7. Verde (Para una nueva variable, ej. Bomba de calor)
        "#FFC107",  # 8. Amarillo/Ambar (Para otra variable, ej. Electricidad)
        "#795548"  # 9. Marrón (Para otra variable extra, ej. Biomasa)
    ]

    # Monthly Resultes
    fig, ax = api.energy_balance(
        sim.monthly,
        q_in_columns=[
            "CollP_kW_calc_MW",
            "BolrPOut_MW",
        ],
        q_out_columns=[
            "QSnkP_MW",
            "QAcum_Tes1_MW",
            "QLoss_Tes1_MW",
        ],
        xlabel="",
        cmap="Paired",
        color=custom_colors
    )
    ax.set_ylabel("Energy (MWh)")
    plt.legend(names_legend, bbox_to_anchor=(1.05, 1), loc="upper left")
    api.export_plots_in_configured_formats(fig, sim.path, "balance-monthly", "balance")

    # Monthly Solites
    fig, ax = api.energy_balance(
        sim.monthly,
        q_in_columns=[
            "solites_solar",
            "solites_aux",
        ],
        q_out_columns=[
            "solites_demand",
            "solites_accum",
            "solites_losses",
        ],
        xlabel="",
        cmap="Paired",
        color=custom_colors
    )
    ax.set_ylabel("Energy (MWh)")
    plt.legend(names_legend, bbox_to_anchor=(1.05, 1), loc="upper left")
    api.export_plots_in_configured_formats(fig, sim.path, "balance-solites-monthly", "balance")

    sim.monthly['solites_solar']    = df_solites[0].values
    sim.monthly['solites_losses']   = df_solites[4].values
    sim.monthly['solites_accum']    = df_solites[5].values
    sim.monthly['solites_aux']      = df_solites[6].values
    sim.monthly['solites_demand']   = df_solites[7].values

    # Yearly
    fig, ax = api.energy_balance(
        sim.scalar,
        q_in_columns=[
            "CollP_kW_calc_MW",
            "BolrPOut_MW",
            "QSrcP_MW"
        ],
        q_out_columns=[
            "QSnkP_MW",
            "QAcum_Tes1_MW",
            "QLoss_Tes1_MW",
            "qSysOut_PipeLoss_MW",
            "QDistrict_MW",
        ],
        xlabel="",
        cmap="Paired",
    )
    ax.set_ylabel("Energy (MWh)")
    plt.legend(names_legend, bbox_to_anchor=(1.05, 1), loc="upper left")
    # plt.show()

    api.export_plots_in_configured_formats(fig, sim.path, "balance-yearly", "balance")


def q_vs_t(sim: api.Simulation):
    #### Q vs T ####
    names_legend = [
        "$Q_{coll}(T_{in})$",
        "$Q_{coll}(T_{out})$",
        "$Q_{dem}(T_{in})$",
        "$Q_{dem}(T_{out})$",
    ]
    plot_variables = [
        ["CollP_kW_calc", "CollTIn"],
        ["CollP_kW_calc", "CollTOut"],
        ["QSnkP_kW", "QSnkTIn"],
        ["QSnkP_kW", "QSnkTOut"],
    ]

    dataframes = pd.DataFrame()  # []

    plt.figure()

    for q, t in plot_variables:
        a = abs(sim.hourly[q])
        b = sim.hourly[t]
        df = pd.DataFrame({q: a, t: b})

        df = df.sort_values(by=t)
        df[q] = np.cumsum(df[q])
        # dataframes = dataframes + a + b
        # dataframes.append(df)

        fig = plt.plot(
            df[t], df[q], label=q + "____" + t
        )  # , linestyle='-', color='blue', label='Q_cum')

    plt.xlabel("Temperature [°C]")
    plt.ylabel("Cumulative energy [kWh]")
    plt.grid()
    plt.legend(names_legend)
    api.export_plots_in_configured_formats(fig[0].figure, sim.path, "q_t", "q_vs_t")


def kpi(sim: api.Simulation):

    ### Calculations ###
    sim.scalar["FactorRenewable"] = (
        sim.scalar["QSnkP_kW_Tot"] - sim.scalar["BolrPOut_kW_Tot"]
    ) / sim.scalar["QSnkP_kW_Tot"]

    ### Create dataframe with Solites KPIs ###
    sim.scalar["zero"] = 0
    data = [
        sim.scalar["IT_kW_m2"],  # 14
        sim.scalar["CollP_kW_calc_Tot"] / 1000,  # 15
        sim.scalar["Q_kW_m2"],  # 16
        sim.scalar["TesQCharge_Tot"] / 1000,  # 18
        sim.scalar["TesQDisharge_Tot"] / 1000,  # 19
        sim.scalar["QLoss_Tes1_Tot"] / 1000,  # 20
        sim.scalar["QDistrict_MW"], #24
        sim.scalar["QAcum_Tes1_Tot"] / 1000,  # 25
        sim.scalar["BolrPOut_kW_Tot"] / 1000,  # 32
        sim.scalar["QDemand_kW_Tot"] / 1000,  # 33
        sim.scalar["SolarControlStagDays"],  # 35
        sim.scalar["TesEff"],  # 37
        sim.scalar["TesNCycles"],  # 38
        sim.scalar["QSnkTIn_Avg"],  # 39
        sim.scalar["QSnkTOut_Avg"],  # 40
    ]
    df = pd.DataFrame(data)

    df.to_csv(sim.path + "\\data.csv", header=False, index=False)


def lcoh(sim: api.Simulation):

    demand = float(sim.scalar["QSnkP_kW_Tot"].iloc[0])  # kWh/a delivered heat
    consumption = float(sim.scalar["BolrPOut_kW_Tot"].iloc[0])  # kWh/a boiler fuel (efficiency = 1 in type6)

    size_solar = float(sim.scalar["CollAcollAp"].iloc[0])  # m2
    size_tes = float(sim.scalar["Vol_Tes1"].iloc[0])  # m3
    # size_boiler = float(sim.hourly["BolrPOut_kW"].max())  # kW, peak hourly boiler output

    cost_solar = 1330.12*size_solar**(-0.0873)  # [€/m2] cost of large-scale solar collector field
    cost_tes = 1.24*27102*size_tes**(-0.527)  # [€/m3] cost of tank TES
    # cost_boiler = 100  # [€/kW] cost of auxiliary boiler



    r = 0.03
    T = 30
    m = 0.01
    fuel_price = 0.08  # [€/kWh]

    b = ((1 + r) ** T - 1) / ((1 + r) ** T * r)
    a = 1 / b
    e_0 = consumption * fuel_price

    I_solar = cost_solar * size_solar
    I_tes = cost_tes * size_tes
    # I_boiler = cost_boiler * size_boiler
    I = I_solar + I_tes #+ I_boiler

    pv_aux = e_0 * b
    pv_maint = I * m * b
    pv_sys = I + pv_aux + pv_maint

    annuity = a * pv_sys
    lcoe = annuity / demand

    sim.scalar["I_solar"] = I_solar
    sim.scalar["I_tes"] = I_tes
    # sim.scalar["I_boiler"] = I_boiler
    sim.scalar["I_total"] = I
    sim.scalar["annuity"] = annuity
    sim.scalar["LCOH"] = lcoe

    print("LCOH of the system: " + str(lcoe) + " €/kWh")


def to_json(sim: api.Simulation):
    sim.scalar.to_json(sim.path + r"\output.json", orient="records", indent=4)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print(f"ERROR: Usage: {sys.argv[0]} <path-to-results-folder>", file=sys.stderr)
        sys.exit(-1)

    path_to_results_folder = pl.Path(sys.argv[1])
    api.global_settings.reader.force_reread_prt = False
    api.global_settings.reader.read_step_files = True

    processing_steps = [
        filter,
        weather,
        solar,
        # hx,
        ttes,
        # hp,
        boiler,
        source,
        demand,
        balance,
        q_vs_t,
        kpi,
        lcoh,
        to_json,
    ]

    simulation_data = api.process_whole_result_set(
        path_to_results_folder,
        processing_steps,
    )
