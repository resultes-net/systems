*************************************
**BEGIN control.ddck
*************************************
EQUATIONS #

** Weather
TRoomStore = tAmb

** Collectors
MfrPuCollPri = SolarControlPuPriOn * CollMfrOut
MfrPuCollSec = SolarControlPuSecOn * MfrPuCollPri * Lloop2Cp/Lloop5Cp
TSetColl = TSetDem + HxCollLMTDNom + 3

** Auxiliary source
MfrQSrc = QSrcM
MfrPuQSrcSec = MfrQSrc*QSrcControlPuQSrcSecOn
MfrSources = MfrPuCollSec + MfrPuQSrcSec

** Demand
MfrQSnk = QSnkM

** Stratification
xFracValStrat = NOT(ValStratControlHot)

*************************
** Demand mixing valve **
*************************
EQUATIONS #
T_set_ValMix = TSetDem

UNIT 441 TYPE 811 ! Passive Divider for heating 
PARAMETERS 1
10 !Nb.of iterations before fixing the value
INPUTS 4 
TBolr_ValMix
TTeeMix_ValMix
MValMix_SCnr
T_set_ValMix
*** INITIAL INPUT VALUES
35.0 21.0 800.0 T_set_ValMix
EQUATIONS 1
xFracValMix =  1.-[441,5]